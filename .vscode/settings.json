{
  // clangd owns C/C++ IntelliSense; avoid conflicts if ms-vscode.cpptools is installed.
  "C_Cpp.intelliSenseEngine": "disabled",

  // Compilation database for the C++ runtime (retro_*.cpp + vendored llama.cpp).
  // Generated by `scripts/gen-compile-commands.sh`; re-run it after adding a
  // source file or changing include paths. Also declared in .clangd for
  // non-VSCode clangd clients.
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/crates/retrograd-ffi/runtime/build",
    "--background-index",
    "--header-insertion=never",
    "--completion-style=detailed"
  ],
  "clangd.detectExtensionConflicts": true,

  // rust-analyzer: keep the root crate (default discovery) and add the pyo3 binding crate,
  // which lives outside the root Cargo project.
  "rust-analyzer.linkedProjects": [
    "${workspaceFolder}/Cargo.toml",
    "${workspaceFolder}/python/native/Cargo.toml"
  ],

  // Python binding (uv-managed venv under python/)
  "python.defaultInterpreterPath": "${workspaceFolder}/python/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.analysis.extraPaths": ["${workspaceFolder}/python/src"],
  "python.analysis.typeCheckingMode": "basic",

  // Index only project sources. Pylance still resolves environment packages
  // through `defaultInterpreterPath` without indexing the environment or vendor tree.
  "python.analysis.exclude": [
    "**/.venv/**",
    "**/node_modules/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/.ruff_cache/**",
    "target/**",
    "runs/**",
    "generated/**",
    "crates/retrograd-ffi/runtime/vendor/**",
    "crates/retrograd-ffi/runtime/build/**"
  ],

  // pytest runs from python/ so pyproject.toml (testpaths) applies
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/python",
  "python.testing.pytestArgs": ["tests"],

  // Ruff (lint + import sorting) configured by the root ruff.toml
  "ruff.configuration": "${workspaceFolder}/ruff.toml",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },

  "[rust]": {
    "editor.inlayHints.enabled": "onUnlessPressed"
  },

  "rust-analyzer.inlayHints.chainingHints.enable": false,
  "rust-analyzer.inlayHints.parameterHints.enable": false,

  "rust-analyzer.inlayHints.typeHints.enable": true,
  "rust-analyzer.inlayHints.typeHints.hideNamedConstructor": true,
  "rust-analyzer.inlayHints.typeHints.hideClosureParameter": true,

  "rust-analyzer.inlayHints.closingBraceHints.enable": false,
  "rust-analyzer.inlayHints.maxLength": 20,

  // Keep build artifacts and caches out of search/watchers.
  // Only the heavy/noisy parts of the llama.cpp submodule are excluded: watching
  // its sources is what lets the Git view refresh submodule changes on its own.
  "files.watcherExclude": {
    "**/target/**": true,
    "**/runtime/build/**": true,
    "**/runtime/vendor/llama.cpp/build/**": true,
    "**/runtime/vendor/llama.cpp/.git/**": true,
    "**/runtime/vendor/llama.cpp/models/**": true,
    "**/.venv/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/__pycache__/**": true
  },
  "search.exclude": {
    "**/target": true,
    "crates/retrograd-ffi/runtime/build": true,
    "crates/retrograd-ffi/runtime/vendor": true,
    "**/.venv": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/__pycache__": true,
    "python/uv.lock": true
  },
}
