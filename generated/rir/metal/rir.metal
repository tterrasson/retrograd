    uint n_col;
    uint n_row;
    uint n_plane;
    uint n_batch;
    uint n_col_b;
    uint n_row_b;
    uint n_plane_b;
    uint n_batch_b;
    uint a_nb0;
    uint a_nb1;
    uint a_nb2;
    uint a_nb3;
    uint b_nb0;
    uint b_nb1;
    uint b_nb2;
    uint b_nb3;
    uint dst_nb0;
    uint dst_nb1;
    uint dst_nb2;
    uint dst_nb3;
};

kernel void rir_add_repeat_f16(
    device const uchar* a [[buffer(0)]],
    device const uchar* b [[buffer(1)]],
    device uchar* dst [[buffer(2)]],
    constant rir_add_repeat_f16_params& pc [[buffer(3)]],
    uint3 group_id [[threadgroup_position_in_grid]],
    uint3 global_id [[thread_position_in_grid]],
    uint simd_lane_id [[thread_index_in_simdgroup]])
{
    const uint col_v0 = global_id.x;
    if (col_v0 >= pc.n_col) {
        return;
    }
    const uint row_v1 = global_id.y;
    if (row_v1 >= pc.n_row) {
        return;
    }
    const uint plane_v2 = global_id.z;
    if (plane_v2 >= pc.n_plane) {
        return;
    }
    const uint base_v11 = col_v0 * pc.a_nb0 + row_v1 * pc.a_nb1 + plane_v2 * pc.a_nb2;
    const uint rep_v5 = col_v0 % pc.n_col_b;
    const uint rep_v6 = row_v1 % pc.n_row_b;
    const uint rep_v7 = plane_v2 % pc.n_plane_b;
    const uint base_v12 = rep_v5 * pc.b_nb0 + rep_v6 * pc.b_nb1 + rep_v7 * pc.b_nb2;
    const uint base_v13 = col_v0 * pc.dst_nb0 + row_v1 * pc.dst_nb1 + plane_v2 * pc.dst_nb2;
    for (uint batch_v3 = 0u; batch_v3 < pc.n_batch; ++batch_v3) {
        const float t_v4 = float(*(device const half *)(a + (batch_v3 * pc.a_nb3 + base_v11)));
        const uint rep_v8 = batch_v3 % pc.n_batch_b;
        const float t_v9 = float(*(device const half *)(b + (rep_v8 * pc.b_nb3 + base_v12)));
        const float t_v10 = t_v4 + t_v9;
        *(device half *)(dst + (batch_v3 * pc.dst_nb3 + base_v13)) = half(t_v10);
    }
}

// ---- add_repeat_f16_vec4 ----
struct rir_add_repeat_f16_vec4_params {
    uint n_col;
    uint n_row;
    uint n_plane;
    uint n_batch;
    uint n_col_b;
    uint n_row_b;
    uint n_plane_b;
    uint n_batch_b;
    uint a_nb0;
    uint a_nb1;
    uint a_nb2;
    uint a_nb3;
    uint b_nb0;
    uint b_nb1;
    uint b_nb2;
    uint b_nb3;
    uint dst_nb0;
    uint dst_nb1;
    uint dst_nb2;
    uint dst_nb3;
};

kernel void rir_add_repeat_f16_vec4(
    device const uchar* a [[buffer(0)]],
    device const uchar* b [[buffer(1)]],
    device uchar* dst [[buffer(2)]],
    constant rir_add_repeat_f16_vec4_params& pc [[buffer(3)]],
    uint3 group_id [[threadgroup_position_in_grid]],
    uint3 global_id [[thread_position_in_grid]],
    uint simd_lane_id [[thread_index_in_simdgroup]])
{
    const uint col_v0 = global_id.x * 4u;
    if (col_v0 >= pc.n_col) {
        return;
    }
    const uint row_v1 = global_id.y;
    if (row_v1 >= pc.n_row) {
        return;
    }
    const uint plane_v2 = global_id.z;
    if (plane_v2 >= pc.n_plane) {
        return;
    }
    const uint rep_v14 = row_v1 % pc.n_row_b;
    const uint rep_v15 = plane_v2 % pc.n_plane_b;
    const uint base_v22 = col_v0 * pc.a_nb0 + row_v1 * pc.a_nb1 + plane_v2 * pc.a_nb2;
    const uint rep_v5 = col_v0 % pc.n_col_b;
    const uint base_v23 = rep_v5 * pc.b_nb0 + rep_v14 * pc.b_nb1 + rep_v15 * pc.b_nb2;
    const uint base_v24 = col_v0 * pc.dst_nb0 + row_v1 * pc.dst_nb1 + plane_v2 * pc.dst_nb2;
    for (uint batch_v3 = 0u; batch_v3 < pc.n_batch; ++batch_v3) {
        const uint base_v19 = row_v1 * pc.a_nb1 + plane_v2 * pc.a_nb2 + batch_v3 * pc.a_nb3;
        const uint rep_v16 = batch_v3 % pc.n_batch_b;
        const uint base_v20 = rep_v14 * pc.b_nb1 + rep_v15 * pc.b_nb2 + rep_v16 * pc.b_nb3;
        const uint base_v21 = row_v1 * pc.dst_nb1 + plane_v2 * pc.dst_nb2 + batch_v3 * pc.dst_nb3;
        if (col_v0 + 4u <= pc.n_col) {
            const float4 t_v4 = float4(*(device const packed_half4 *)(a + (batch_v3 * pc.a_nb3 + base_v22)));
            const float4 t_v9 = float4(*(device const packed_half4 *)(b + (rep_v16 * pc.b_nb3 + base_v23)));
            const float4 t_v10 = t_v4 + t_v9;
            *(device packed_half4 *)(dst + (batch_v3 * pc.dst_nb3 + base_v24)) = packed_half4(t_v10);
        } else {
            for (uint col_tail_v11 = col_v0; col_tail_v11 < pc.n_col; ++col_tail_v11) {
                const float t_v12 = float(*(device const half *)(a + (col_tail_v11 * pc.a_nb0 + base_v19)));
                const uint rep_v13 = col_tail_v11 % pc.n_col_b;
                const float t_v17 = float(*(device const half *)(b + (rep_v13 * pc.b_nb0 + base_v20)));
                const float t_v18 = t_v12 + t_v17;
                *(device half *)(dst + (col_tail_v11 * pc.dst_nb0 + base_v21)) = half(t_v18);
            }
        }
    }
}

