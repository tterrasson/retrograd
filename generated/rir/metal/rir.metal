kernel void rir_mul_repeat_f16(
    device const uchar* a [[buffer(0)]],
    device const uchar* b [[buffer(1)]],
    device uchar* dst [[buffer(2)]],
    constant rir_mul_repeat_f16_params& pc [[buffer(3)]],
    uint3 group_id [[threadgroup_position_in_grid]],
    uint3 global_id [[thread_position_in_grid]],
    uint simd_lane_id [[thread_index_in_simdgroup]])
{
    const uint col_v0 = global_id.x;
    if (col_v0 >= pc.n_col) {
        return;
    }
    const uint row_v1 = global_id.y;
    if (row_v1 >= pc.n_row) {
        return;
    }
    const uint plane_v2 = global_id.z;
    if (plane_v2 >= pc.n_plane) {
        return;
    }
    const uint base_v11 = col_v0 * pc.a_nb0 + row_v1 * pc.a_nb1 + plane_v2 * pc.a_nb2;
    const uint rep_v5 = col_v0 % pc.n_col_b;
    const uint rep_v6 = row_v1 % pc.n_row_b;
    const uint rep_v7 = plane_v2 % pc.n_plane_b;
    const uint base_v12 = rep_v5 * pc.b_nb0 + rep_v6 * pc.b_nb1 + rep_v7 * pc.b_nb2;
    const uint base_v13 = col_v0 * pc.dst_nb0 + row_v1 * pc.dst_nb1 + plane_v2 * pc.dst_nb2;
    for (uint batch_v3 = 0u; batch_v3 < pc.n_batch; ++batch_v3) {
        const float t_v4 = float(*(device const half *)(a + (batch_v3 * pc.a_nb3 + base_v11)));
        const uint rep_v8 = batch_v3 % pc.n_batch_b;
        const float t_v9 = float(*(device const half *)(b + (rep_v8 * pc.b_nb3 + base_v12)));
        const float t_v10 = t_v4 * t_v9;
        *(device half *)(dst + (batch_v3 * pc.dst_nb3 + base_v13)) = half(t_v10);
    }
}

